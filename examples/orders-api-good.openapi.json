{
  "openapi": "3.1.0",
  "info": {
    "title": "Orders Reference API",
    "version": "1.2.0",
    "description": "Reference OpenAPI 3.1 specification compliant with all 22 automated API Design Principles rules."
  },
  "servers": [
    {
      "url": "https://api.example.com/v1",
      "description": "Production API v1"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/v1/orders": {
      "get": {
        "operationId": "listOrders",
        "summary": "List paginated customer orders",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Opaque keyset pagination cursor returned by the previous page.",
            "schema": { "type": "string", "maxLength": 128 }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of orders to return per page.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "enum": ["pending", "paid", "shipped", "cancelled"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of orders",
            "headers": {
              "RateLimit-Limit": { "schema": { "type": "integer" } },
              "RateLimit-Remaining": { "schema": { "type": "integer" } },
              "RateLimit-Reset": { "schema": { "type": "integer" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OrderPage" },
                "example": {
                  "data": [
                    {
                      "id": "ord_01J9Z4K8M2P7X3Q9W5V",
                      "status": "paid",
                      "amount_minor": 4990,
                      "currency": "USD",
                      "created_at": "2026-11-16T10:00:00Z"
                    }
                  ],
                  "next_cursor": "eyJpZCI6Im9yZF8wMUo5WjRLOE0yIn0"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProblemValidationError" },
          "401": { "$ref": "#/components/responses/ProblemUnauthorized" },
          "429": { "$ref": "#/components/responses/ProblemRateLimited" }
        }
      },
      "post": {
        "operationId": "createOrder",
        "summary": "Create a new order idempotently",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Client-generated UUIDv4/v7 key guaranteeing safe retries for 24 hours.",
            "schema": { "type": "string", "format": "uuid", "maxLength": 64 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrderRequest" },
              "example": {
                "currency": "USD",
                "items": [
                  { "sku": "SKU-PRO-PLAN", "quantity": 1, "unit_price_minor": 4990 }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created successfully",
            "headers": {
              "Location": {
                "description": "Canonical URI of the newly created order",
                "schema": { "type": "string", "format": "uri" }
              },
              "ETag": {
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" },
                "example": {
                  "id": "ord_01J9Z4K8M2P7X3Q9W5V",
                  "status": "pending",
                  "amount_minor": 4990,
                  "currency": "USD",
                  "created_at": "2026-11-16T10:05:00Z"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProblemValidationError" },
          "401": { "$ref": "#/components/responses/ProblemUnauthorized" },
          "409": { "$ref": "#/components/responses/ProblemConflict" },
          "429": { "$ref": "#/components/responses/ProblemRateLimited" }
        }
      }
    },
    "/v1/orders/{order_id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Retrieve a single order by ID",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "maxLength": 64 }
          }
        ],
        "responses": {
          "200": {
            "description": "Order details",
            "headers": {
              "ETag": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" },
                "example": {
                  "id": "ord_01J9Z4K8M2P7X3Q9W5V",
                  "status": "paid",
                  "amount_minor": 4990,
                  "currency": "USD",
                  "created_at": "2026-11-16T10:00:00Z"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/ProblemUnauthorized" },
          "404": { "$ref": "#/components/responses/ProblemNotFound" },
          "429": { "$ref": "#/components/responses/ProblemRateLimited" }
        }
      },
      "patch": {
        "operationId": "updateOrder",
        "summary": "Partially update an order with optimistic concurrency",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "maxLength": 64 }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "Current ETag of the order to prevent lost concurrent updates.",
            "schema": { "type": "string", "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/merge-patch+json": {
              "schema": { "$ref": "#/components/schemas/UpdateOrderRequest" },
              "example": { "status": "cancelled" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated order",
            "headers": {
              "ETag": { "schema": { "type": "string" } }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" },
                "example": {
                  "id": "ord_01J9Z4K8M2P7X3Q9W5V",
                  "status": "cancelled",
                  "amount_minor": 4990,
                  "currency": "USD",
                  "created_at": "2026-11-16T10:00:00Z"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/ProblemValidationError" },
          "404": { "$ref": "#/components/responses/ProblemNotFound" },
          "412": { "$ref": "#/components/responses/ProblemConflict" },
          "429": { "$ref": "#/components/responses/ProblemRateLimited" }
        }
      },
      "delete": {
        "operationId": "deleteOrder",
        "summary": "Cancel and archive an order",
        "tags": ["Orders"],
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "maxLength": 64 }
          }
        ],
        "responses": {
          "204": {
            "description": "Order cancelled and archived"
          },
          "401": { "$ref": "#/components/responses/ProblemUnauthorized" },
          "404": { "$ref": "#/components/responses/ProblemNotFound" },
          "429": { "$ref": "#/components/responses/ProblemRateLimited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Order": {
        "type": "object",
        "required": ["id", "status", "amount_minor", "currency", "created_at"],
        "properties": {
          "id": { "type": "string", "maxLength": 64, "example": "ord_01J9Z4K8M2P7X3Q9W5V" },
          "status": { "type": "string", "enum": ["pending", "paid", "shipped", "cancelled"] },
          "amount_minor": { "type": "integer", "minimum": 0, "maximum": 100000000 },
          "currency": { "type": "string", "minLength": 3, "maxLength": 3, "example": "USD" },
          "created_at": { "type": "string", "format": "date-time", "example": "2026-11-16T10:00:00Z" }
        }
      },
      "OrderPage": {
        "type": "object",
        "required": ["data"],
        "properties": {
          "data": {
            "type": "array",
            "maxItems": 100,
            "items": { "$ref": "#/components/schemas/Order" }
          },
          "next_cursor": { "type": "string", "maxLength": 128 }
        }
      },
      "OrderItemInput": {
        "type": "object",
        "required": ["sku", "quantity", "unit_price_minor"],
        "properties": {
          "sku": { "type": "string", "minLength": 1, "maxLength": 64 },
          "quantity": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "unit_price_minor": { "type": "integer", "minimum": 0, "maximum": 10000000 }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": ["currency", "items"],
        "properties": {
          "currency": { "type": "string", "minLength": 3, "maxLength": 3, "example": "USD" },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": { "$ref": "#/components/schemas/OrderItemInput" }
          }
        }
      },
      "UpdateOrderRequest": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["cancelled"] }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "required": ["type", "title", "status"],
        "properties": {
          "type": { "type": "string", "format": "uri", "maxLength": 256 },
          "title": { "type": "string", "maxLength": 128 },
          "status": { "type": "integer", "minimum": 400, "maximum": 599 },
          "detail": { "type": "string", "maxLength": 512 },
          "instance": { "type": "string", "maxLength": 256 }
        }
      }
    },
    "responses": {
      "ProblemValidationError": {
        "description": "Invalid request payload or query parameters",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" },
            "example": {
              "type": "https://api.example.com/errors/validation",
              "title": "Validation Failed",
              "status": 400,
              "detail": "items[0].quantity must be >= 1"
            }
          }
        }
      },
      "ProblemUnauthorized": {
        "description": "Missing or invalid bearer token",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" },
            "example": {
              "type": "https://api.example.com/errors/unauthorized",
              "title": "Unauthorized",
              "status": 401
            }
          }
        }
      },
      "ProblemNotFound": {
        "description": "Resource not found",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" },
            "example": {
              "type": "https://api.example.com/errors/not-found",
              "title": "Order Not Found",
              "status": 404
            }
          }
        }
      },
      "ProblemConflict": {
        "description": "Resource conflict or precondition failed",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" },
            "example": {
              "type": "https://api.example.com/errors/conflict",
              "title": "Conflict",
              "status": 409
            }
          }
        }
      },
      "ProblemRateLimited": {
        "description": "Too many requests",
        "headers": {
          "Retry-After": { "schema": { "type": "integer" } },
          "RateLimit-Limit": { "schema": { "type": "integer" } },
          "RateLimit-Remaining": { "schema": { "type": "integer" } },
          "RateLimit-Reset": { "schema": { "type": "integer" } }
        },
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/ProblemDetails" },
            "example": {
              "type": "https://api.example.com/errors/rate-limited",
              "title": "Too Many Requests",
              "status": 429,
              "detail": "Rate limit exceeded; retry after 12 seconds."
            }
          }
        }
      }
    }
  }
}
